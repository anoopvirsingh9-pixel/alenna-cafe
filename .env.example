# Copy this file to .env and fill in your values.

# Postgres connection (change password if yours is different)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Staff dashboard access code (change before going live)
ADMIN_PIN=4400

# Optional: for production, use a real secret
ADMIN_SESSION_SECRET=change-me-to-a-random-string

# Optional: when you add real SMS / email, put the provider keys here
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# RESEND_API_KEY=
